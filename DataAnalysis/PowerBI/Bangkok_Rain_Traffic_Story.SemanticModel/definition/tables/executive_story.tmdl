table executive_story
	lineageTag: 50cb9e0e-4618-5b3a-8ec1-6a66426bc51b

	measure 'Active Step' = IF(SELECTEDVALUE(ui_lang[lang], "en") = "th", MAX(executive_story[step_th]), MAX(executive_story[step]))
		lineageTag: 793932fe-abe8-5672-b872-70c4a17ecd4e

	measure 'Active Headline' = IF(SELECTEDVALUE(ui_lang[lang], "en") = "th", MAX(executive_story[headline_th]), MAX(executive_story[headline]))
		lineageTag: 5cdefead-d72d-5227-9bab-75e93d6a3944

	measure 'Active Evidence' = IF(SELECTEDVALUE(ui_lang[lang], "en") = "th", MAX(executive_story[evidence_th]), MAX(executive_story[evidence]))
		lineageTag: 2747469f-7ed4-5b77-9eb1-1888e3d7a927

