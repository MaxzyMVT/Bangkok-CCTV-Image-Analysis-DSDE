model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		fastCombine
	annotation PBI_QueryOrder = ["ui_lang", "city_effect", "stratified_effects", "rain_timing", "natural_experiment", "rebound", "camera", "camera_effect", "camera_summary", "camera_hour", "denser_share", "flood_sensor_hours", "ml_metrics", "ml_feature_importance", "correlations", "executive_story"]
	annotation __PBI_TimeIntelligenceEnabled = 0
	annotation PBI_ProTooling = ["DevMode"]

ref table ui_lang
ref table city_effect
ref table stratified_effects
ref table rain_timing
ref table natural_experiment
ref table rebound
ref table camera
ref table camera_effect
ref table camera_summary
ref table camera_hour
ref table denser_share
ref table flood_sensor_hours
ref table ml_metrics
ref table ml_feature_importance
ref table correlations
ref table executive_story
